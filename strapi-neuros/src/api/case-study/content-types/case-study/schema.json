{
  "kind": "collectionType",
  "collectionName": "case_studies",
  "info": {
    "singularName": "case-study",
    "pluralName": "case-studies",
    "displayName": "Case Study",
    "description": "Migrated from WordPress (postType: neuros_case_study)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "sections.rich-text",
        "sections.image",
        "sections.gallery",
        "sections.embed",
        "sections.table",
        "sections.code",
        "sections.quote",
        "sections.cta",
        "sections.feature",
        "sections.hero"
      ]
    },
    "excerpt": {
      "type": "text"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "caseStudyTag": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::case-study-tag.case-study-tag"
    },
    "publishedDate": {
      "type": "datetime"
    },
    "wpId": {
      "type": "integer"
    },
    "wpLink": {
      "type": "string"
    },
    "features": {
      "type": "blocks"
    }
  }
}
