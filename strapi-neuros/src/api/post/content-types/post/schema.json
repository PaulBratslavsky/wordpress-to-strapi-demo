{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post",
    "description": "Migrated from WordPress (postType: post)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "content": {
      "type": "blocks"
    },
    "excerpt": {
      "type": "text"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag"
    },
    "postFormat": {
      "type": "string"
    },
    "publishedDate": {
      "type": "datetime"
    },
    "wpId": {
      "type": "integer"
    },
    "wpLink": {
      "type": "string"
    },
    "pageTopBorderRadius": {
      "type": "string"
    },
    "mediaQuoteText": {
      "type": "string"
    },
    "mediaQuoteAuthor": {
      "type": "string"
    }
  }
}
