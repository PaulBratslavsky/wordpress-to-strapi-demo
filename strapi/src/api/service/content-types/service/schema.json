      "type": "integer"
    },
    "wpSite": {
      "type": "string"
    },
    "wpLink": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "startingPrice": {
      "type": "integer"
    },
    "timelineWeeks": {
      "type": "integer"
    },
    "deliverables": {
      "type": "text"
    },
    "icon": {
      "type": "string"
    },
    "featured": {
      "type": "boolean"
    },
    "relatedProjects": {
