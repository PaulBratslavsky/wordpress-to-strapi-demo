{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Migrated from WordPress (postType: page)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "sections.rich-text",
        "sections.image",
        "sections.gallery",
        "sections.embed",
        "sections.table",
        "sections.code",
        "sections.quote",
        "sections.cta",
        "sections.feature",
        "sections.hero"
      ]
    },
    "excerpt": {
      "type": "text"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author"
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::page.page"
    },
    "menuOrder": {
      "type": "integer"
    },
    "publishedDate": {
      "type": "datetime"
    },
    "wpId": {
      "type": "integer"
    },
    "wpLink": {
      "type": "string"
    }
  }
}
