{
  "kind": "collectionType",
  "collectionName": "portfolio_items",
  "info": {
    "singularName": "portfolio-item",
    "pluralName": "portfolio-items",
    "displayName": "Portfolio Post",
    "description": "Migrated from WordPress (postType: portfolio_item)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "content": {
      "type": "blocks"
    },
    "excerpt": {
      "type": "text"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author"
    },
    "industry": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::industry.industry"
    },
    "portfolio": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::portfolio.portfolio"
    },
    "publishedDate": {
      "type": "datetime"
    },
    "wpId": {
      "type": "integer"
    },
    "wpSite": {
      "type": "string"
    },
    "wpLink": {
      "type": "string"
    },
    "results": {
      "type": "component",
      "repeatable": false,
      "component": "groups.portfolio-item-results"
    },
    "clientName": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "website": {
      "type": "string"
    },
    "launchDate": {
      "type": "date"
    },
    "servicesProvided": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service.service"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
