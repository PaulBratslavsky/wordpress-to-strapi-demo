# --- WordPress (source) -------------------------------------------------------
# The site's home URL. For a Local site this is usually http://<site-name>.local
WP_URL=http://my-site.local

# Optional but recommended: an Application Password (WP admin -> Users -> Profile
# -> Application Passwords). With it the export also includes drafts, scheduled
# and private posts, raw (unrendered) content, and every author. Without it you
# only get published content. The username is your WP login, not the app name.
WP_USER=
WP_APP_PASSWORD=

# --- Strapi (destination) -----------------------------------------------------
STRAPI_URL=http://localhost:1337

# A Strapi *Full access* API token.
# Admin panel -> Settings -> API Tokens -> Create new API Token -> Full access.
# Or mint one headlessly: node <strapi-project>/scripts/create-api-token.mjs
STRAPI_API_TOKEN=
